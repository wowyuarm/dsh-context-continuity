{
  "name": "@wowyuarm/dsh-context-continuity",
  "version": "0.1.0",
  "description": "A subject's context lived as one continuous timeline across many physical Sessions: rollover, checkpoints, and lineage.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "README.md"
  ],
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run check:boundaries && vitest run",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.1 <0.1.6",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.1.6",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1 <0.1.6",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.5-rc.1 <0.1.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
